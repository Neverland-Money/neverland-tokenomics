{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "moduleResolution": "bundler"
  },
  "include": [
    "hardhat.config.ts",
    "wagmi.config.ts",
    "config/**/*.ts",
    "index.ts",
    "generated/**/*.ts"
  ]
}
