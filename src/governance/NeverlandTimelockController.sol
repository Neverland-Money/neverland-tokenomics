pragma solidity ^0.8.20;

import {TimelockController} from "@openzeppelin-v5/contracts/governance/TimelockController.sol";

/**
 * @title NeverlandTimelockController
 * @notice TimelockController with an immutable lower bound for the live minimum delay.
 * @dev Delay updates still follow the OpenZeppelin self-call model. This
 * extension only prevents the live delay from being reduced below the floor
 * chosen at deployment.
 */
contract NeverlandTimelockController is TimelockController {
    /**
     * @notice Lowest minimum delay this timelock can ever use.
     * @dev Set once at deployment and exposed through the autogenerated getter.
     */
    uint256 public immutable MIN_DELAY_FLOOR;

    /**
     * @notice Reverts when a requested minimum delay is below the immutable floor.
     * @param requested Delay value that was requested.
     * @param floor Immutable floor enforced by this timelock.
     */
    error DelayBelowMinimumFloor(uint256 requested, uint256 floor);

    /**
     * @notice Deploys the timelock with an immutable minimum delay floor.
     * @dev Reverts with {DelayBelowMinimumFloor} if `minDelay < minDelayFloor`.
     * @param minDelay Initial live minimum delay for scheduled operations.
     * @param minDelayFloor Immutable lower bound that future delay updates cannot cross.
     * @param proposers Addresses granted the proposer role.
     * @param executors Addresses granted the executor role.
     * @param admin Address granted DEFAULT_ADMIN_ROLE during bootstrap. This
     * bootstrap admin must renounce the role after setup so the timelock
     * remains self-administered.
     */
    constructor(
        uint256 minDelay,
        uint256 minDelayFloor,
        address[] memory proposers,
        address[] memory executors,
        address admin
    ) TimelockController(minDelay, proposers, executors, admin) {
        if (minDelay < minDelayFloor) {
            revert DelayBelowMinimumFloor(minDelay, minDelayFloor);
        }

        MIN_DELAY_FLOOR = minDelayFloor;
    }

    /**
     * @notice Updates the minimum delay used for future operations.
     * @dev Can only succeed through the timelock's self-call flow inherited from
     * TimelockController, and never below MIN_DELAY_FLOOR. The explicit
     * auth check is kept ahead of the floor check so unauthorized callers
     * still receive OpenZeppelin's canonical TimelockUnauthorizedCaller
     * revert instead of a floor-specific error.
     * @param newDelay New live minimum delay for future scheduled operations.
     */
    function updateDelay(uint256 newDelay) public virtual override {
        address sender = _msgSender();
        if (sender != address(this)) {
            revert TimelockUnauthorizedCaller(sender);
        }

        if (newDelay < MIN_DELAY_FLOOR) {
            revert DelayBelowMinimumFloor(newDelay, MIN_DELAY_FLOOR);
        }

        // Preserve OZ event emission and storage updates rather than
        // duplicating TimelockController internals in this extension.
        super.updateDelay(newDelay);
    }
}
