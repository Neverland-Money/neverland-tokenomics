# Optional public RPC used by fork-aware tests (Monad mainnet, chain id 143).
MAINNET_RPC=https://rpc-mainnet.monadinfra.com

# Optional block pins for fork suites.
MAINNET_FORK_BLOCK=
CLAIM_REFORM_FORK_BLOCK=

# Opt-in gates for fork suites. Unset or false means the suites self-skip.
RUN_MAINNET_FORK_TESTS=false
RUN_CLAIM_REFORM_FORK_TESTS=false
RUN_CLAIM_REFORM_CONTRACT_WORKBOOK=false
RUN_LENDING_FORK_GOVERNANCE_TESTS=false

# Optional TypeChain target override. Defaults to ethers-v6.
ETHERS_V5=false
