{
  "name": "neverland-contracts",
  "version": "1.1.0",
  "description": "Neverland Protocol public smart-contract mirror",
  "license": "BUSL-1.1",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "solhint": "solhint 'src/**/*.sol'",
    "solhint:report": "solhint 'src/**/*.sol' > solhint.txt 2>&1 || true",
    "aderyn:report": "aderyn -o aderyn.md --skip-update-check",
    "clean": "yarn run clean:foundry && yarn run clean:hardhat",
    "clean:foundry": "forge clean",
    "clean:hardhat": "hardhat clean",
    "coverage": "forge coverage --exclude-tests --no-match-coverage '^(script|test)/|^src/leaderboard/ProxyImports\\.sol$' --no-match-test '(GasCosts|UnderTightGas|ProviderArtifactFitsEip170WithLinkedLibraries)' --no-match-path 'test/{audit,journey}/**'",
    "build": "yarn run clean && yarn run build:foundry && yarn run build:hardhat && yarn run build:wagmi",
    "build:foundry": "forge build",
    "build:hardhat": "hardhat compile",
    "build:wagmi": "wagmi generate",
    "governance:test:foundry": "forge test --match-path 'test/governance/*.t.sol' --no-match-contract '.*Fork.*'",
    "governance:test:lending-fork": "RUN_LENDING_FORK_GOVERNANCE_TESTS=true forge test --match-path 'test/governance/LendingTimelockBoundariesFork.t.sol' -vv",
    "test:claim-reform:workbook-contract": "RUN_CLAIM_REFORM_CONTRACT_WORKBOOK=true forge test --match-contract '^ClaimReformContractWorkbookTest$' -v",
    "test:claim-reform:predeploy": "FOUNDRY_PROFILE=claim-reform-predeploy forge test --match-contract '^(ClaimReformStatefulInvariantTest|RevenueRewardEpochLedgerInvariantTest)$' -v && yarn test:claim-reform:workbook-contract",
    "test:claim-reform:fork": "RUN_CLAIM_REFORM_FORK_TESTS=true forge test --match-path test/claim-reform/fork/ClaimReformMainnetFork.t.sol -v",
    "test:invariants:deep": "FOUNDRY_PROFILE=deep-invariants forge test --match-path 'test/oracles/invariant/**' -v",
    "tests": "yarn run tests:foundry",
    "tests:foundry": "forge test -v --no-match-contract '.*Fork.*'",
    "format": "forge fmt && yarn prettier --write .",
    "format:check": "forge fmt --check && yarn prettier --check ."
  },
  "devDependencies": {
    "@cyfrin/aderyn": "^0.6.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-foundry": "^1.2.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=20.0.0",
    "@wagmi/cli": "^2.6.0",
    "chai": "^4.2.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.6.2",
    "solhint": "^6.0.1",
    "solidity-coverage": "^0.8.16",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@types/minimatch": "5.1.2"
  }
}
