{
  "name": "neverland-contracts",
  "version": "1.0.2",
  "description": "Neverland Protocol public smart-contract mirror",
  "license": "BUSL-1.1",
  "scripts": {
    "solhint": "solhint 'src/**/*.sol'",
    "solhint:report": "solhint 'src/**/*.sol' > solhint.txt 2>&1 || true",
    "aderyn:report": "aderyn -o aderyn.md --skip-update-check",
    "clean": "yarn run clean:foundry && yarn run clean:hardhat",
    "clean:foundry": "forge clean",
    "clean:hardhat": "hardhat clean",
    "coverage:oracles": "FOUNDRY_PROFILE=oracle-coverage forge coverage --exclude-tests --no-match-coverage '^(script|test)/'",
    "coverage:legendary-ledger": "FOUNDRY_PROFILE=legendary-ledger-coverage forge coverage --match-path test/legendary-ledger/DustLockLegendaryLedgerCoverage.t.sol --exclude-tests --no-match-coverage '^(script|test)/'",
    "coverage:governance": "FOUNDRY_PROFILE=governance-coverage forge coverage --exclude-tests --no-match-coverage '^(script|test)/'",
    "build": "yarn run clean && yarn run build:foundry && yarn run build:hardhat && yarn run build:wagmi",
    "build:foundry": "forge build",
    "build:hardhat": "hardhat compile",
    "build:wagmi": "wagmi generate",
    "tests": "yarn run tests:foundry && yarn run tests:hardhat",
    "tests:foundry": "forge test -v",
    "tests:hardhat": "hardhat test",
    "format": "forge fmt && yarn prettier --write ."
  },
  "devDependencies": {
    "@cyfrin/aderyn": "^0.6.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-foundry": "^1.2.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=20.0.0",
    "@wagmi/cli": "^2.6.0",
    "chai": "^4.2.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.6.2",
    "solhint": "^6.0.1",
    "solidity-coverage": "^0.8.16",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@types/minimatch": "5.1.2"
  }
}
